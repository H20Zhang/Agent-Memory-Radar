{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Memory Radar Paper",
  "type": "object",
  "required": ["id", "title", "authors", "published", "first_seen", "paper_url", "primary_category", "tags", "relevance", "importance", "visual_explainer", "analysis", "provenance"],
  "dependentRequired": {
    "published_at": ["first_seen_at", "radar_published_at", "time_provenance", "map_delta"],
    "first_seen_at": ["published_at", "radar_published_at", "time_provenance", "map_delta"],
    "radar_published_at": ["published_at", "first_seen_at", "time_provenance", "map_delta"],
    "time_provenance": ["published_at", "first_seen_at", "radar_published_at", "map_delta"],
    "map_delta": ["published_at", "first_seen_at", "radar_published_at", "time_provenance"],
    "direction_keys": ["published_at", "first_seen_at", "radar_published_at", "time_provenance", "map_delta"]
  },
  "oneOf": [
    {
      "required": ["published_at", "first_seen_at", "radar_published_at", "time_provenance", "map_delta"]
    },
    {
      "allOf": [
        {"not": {"required": ["published_at"]}},
        {"not": {"required": ["first_seen_at"]}},
        {"not": {"required": ["radar_published_at"]}},
        {"not": {"required": ["time_provenance"]}},
        {"not": {"required": ["map_delta"]}}
      ]
    }
  ],
  "allOf": [
    {
      "if": {"required": ["direction_keys"]},
      "then": {
        "properties": {
          "time_provenance": {"const": "native_v2"}
        }
      }
    }
  ],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "published": {"type": "string"},
    "first_seen": {"type": "string"},
    "published_at": {"type": "string"},
    "first_seen_at": {"type": ["string", "null"]},
    "radar_published_at": {"type": ["string", "null"]},
    "time_provenance": {"enum": ["native_v2", "legacy_unknown"]},
    "map_delta": {"enum": ["none", "early_signal", "reinforces", "revises", "splits", "retires"]},
    "direction_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "paper_url": {"type": "string"},
    "code_url": {"type": ["string", "null"]},
    "project_url": {"type": ["string", "null"]},
    "primary_category": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "relevance": {"type": "number", "minimum": 0, "maximum": 1},
    "importance": {"type": "integer", "minimum": 1, "maximum": 5},
    "visual_explainer": {
      "type": "object",
      "required": ["status", "path", "format", "generator", "grounding", "last_verified"],
      "properties": {
        "status": {"enum": ["not_required", "pending", "blocked", "generated"]},
        "path": {"type": ["string", "null"]},
        "format": {"const": "webp"},
        "generator": {"const": "gpt-image"},
        "grounding": {"const": "full-paper"},
        "last_verified": {"type": ["string", "null"]},
        "blocker": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["discovered_from", "analyzed_from"],
      "properties": {
        "discovered_from": {"type": "array", "items": {"type": "string"}},
        "analyzed_from": {"type": "array", "items": {"type": "string"}},
        "last_verified": {"type": ["string", "null"]}
      }
    },
    "analysis": {
      "type": "object",
      "required": ["tldr", "problem", "core_idea", "memory_design", "compared_to", "evidence", "why_it_matters", "limitations", "confidence"],
      "properties": {
        "tldr": {"type": "string"},
        "problem": {"type": "string"},
        "core_idea": {"type": "string"},
        "memory_design": {
          "type": "object",
          "required": ["write", "organize", "read", "update_forget"],
          "properties": {
            "write": {"type": "string"},
            "organize": {"type": "string"},
            "read": {"type": "string"},
            "update_forget": {"type": "string"}
          }
        },
        "compared_to": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "string"},
        "why_it_matters": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  }
}
